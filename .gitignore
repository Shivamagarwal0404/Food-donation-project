# =============================================================================
# FoodShare — .gitignore
# =============================================================================

# --- Environment / Secrets ---
.env
.env.*
!.env.example
!.env.prod.example

# --- Python / Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
test_db.sqlite3
media/
staticfiles/
static_root/

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Node / React ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build output
dist/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# --- Deployment archives ---
*.tar.gz
*.zip

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
