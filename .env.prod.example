# =============================================================================
# FoodShare — Production Environment Variables Template (.env.prod.example)
# Instructions:
# 1. Copy this file to `.env.prod` on your EC2 instance:
#    cp .env.prod.example .env.prod
# 2. Fill in your actual values below (especially RDS endpoint & database password).
# 3. NEVER commit .env.prod or real credentials to version control.
# =============================================================================

# --- Django Core Settings ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-cryptographically-strong-secret-key-min-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=13.232.142.35,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://13.232.142.35
CORS_ALLOWED_ORIGINS=http://13.232.142.35

# --- Security & SSL (Disabled for initial HTTP-only EC2 deployment) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- PostgreSQL Database (External AWS RDS) ---
POSTGRES_DB=foodshare_db
POSTGRES_USER=foodshare_user
POSTGRES_PASSWORD=replace-with-rds-master-password
POSTGRES_HOST=replace-with-rds-endpoint-hostname
POSTGRES_PORT=5432

# --- JWT Authentication ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email Notifications & OTP Delivery ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=noreply@foodshare.org

# --- Storage ---
USE_S3=False

